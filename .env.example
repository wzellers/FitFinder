# Required: Supabase project credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required: OpenWeatherMap API key (free tier). Server-only — do not prefix
# with NEXT_PUBLIC_, or it is copied into the browser bundle.
OPENWEATHERMAP_API_KEY=your-openweathermap-api-key

# Required: Anthropic API key (for clothing auto-detection)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: the daily outfit email (see README → Daily outfit email setup).
# Server-only; only needed where /api/email/send-due runs (Vercel).
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# RESEND_API_KEY=your-resend-api-key
# CRON_SECRET=a-long-random-string
# EMAIL_FROM=FitFinder <daily@your-domain.com>
# APP_URL=https://your-app.example.com
