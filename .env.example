# Required: Supabase project credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required: OpenWeatherMap API key (free tier). Server-only — do not prefix
# with NEXT_PUBLIC_, or it is copied into the browser bundle.
OPENWEATHERMAP_API_KEY=your-openweathermap-api-key

# Clothing auto-detection (Claude Haiku 4.5). Either the Anthropic API...
ANTHROPIC_API_KEY=your-anthropic-api-key

# ...or Amazon Bedrock (see README: "Clothing detection on Amazon Bedrock").
# Vercel reserves AWS_* names, so these use a BEDROCK_ prefix.
# CLAUDE_PROVIDER=bedrock
# BEDROCK_AWS_REGION=us-east-1
# BEDROCK_AWS_ACCESS_KEY_ID=your-iam-access-key-id
# BEDROCK_AWS_SECRET_ACCESS_KEY=your-iam-secret-access-key
# BEDROCK_AWS_SESSION_TOKEN=optional-for-temporary-credentials
# BEDROCK_MODEL_ID=anthropic.claude-haiku-4-5
